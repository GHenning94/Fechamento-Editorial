{
  "manifestVersion": 5,
  "id": "com.editorial.autoclose",
  "name": "EDITORIAL AUTOCLOSE",
  "version": "1.0.0",
  "main": "index.html",
  "host": {
    "app": "ID",
    "minVersion": "20.0"
  },
  "entrypoints": [
    {
      "type": "command",
      "id": "openCapasAutoclose",
      "label": {
        "default": "Abrir CAPAS AUTOCLOSE"
      }
    },
    {
      "type": "panel",
      "id": "editorialAutoclosePanel",
      "label": {
        "default": "EDITORIAL AUTOCLOSE"
      },
      "minimumSize": {
        "width": 280,
        "height": 420
      },
      "preferredDockedSize": {
        "width": 300,
        "height": 520
      },
      "preferredFloatingSize": {
        "width": 300,
        "height": 520
      }
    },
    {
      "type": "panel",
      "id": "capasAutoclosePanel",
      "label": {
        "default": "CAPAS AUTOCLOSE"
      },
      "minimumSize": {
        "width": 280,
        "height": 420
      },
      "preferredDockedSize": {
        "width": 300,
        "height": 520
      },
      "preferredFloatingSize": {
        "width": 300,
        "height": 520
      }
    }
  ],
  "icons": [
    {
      "width": 23,
      "height": 23,
      "path": "icons/icon.png",
      "scale": [
        1,
        2
      ]
    }
  ],
  "requiredPermissions": {
    "localFileSystem": "fullAccess",
    "clipboard": "readAndWrite",
    "network": {
      "domains": "all"
    },
    "ipc": {
      "enablePluginCommunication": true
    },
    "launchProcess": {
      "schemes": [
        "https",
        "http",
        "file"
      ],
      "extensions": [
        ".ccx"
      ]
    }
  }
}
