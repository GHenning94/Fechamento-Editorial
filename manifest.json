{
  "manifestVersion": 5,
  "id": "com.editorial.autoclose",
  "name": "EDITORIAL AUTOCLOSE",
  "version": "1.0.0",
  "main": "index.html",
  "host": {
    "app": "ID",
    "minVersion": "20.0"
  },
  "entrypoints": [
    {
      "type": "panel",
      "id": "editorialAutoclosePanel",
      "label": {
        "default": "EDITORIAL AUTOCLOSE"
      },
      "minimumSize": {
        "width": 280,
        "height": 400
      },
      "preferredDockedSize": {
        "width": 320,
        "height": 600
      },
      "preferredFloatingSize": {
        "width": 360,
        "height": 650
      }
    }
  ],
  "icons": [
    {
      "width": 23,
      "height": 23,
      "path": "icons/icon.png",
      "scale": [1, 2]
    }
  ],
  "requiredPermissions": {
    "localFileSystem": "fullAccess",
    "clipboard": "readAndWrite",
    "network": {
      "domains": "all"
    }
  }
}
