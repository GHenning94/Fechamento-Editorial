{
  "framework": null,
  "installCommand": "echo skipped",
  "buildCommand": "npm run vercel-build",
  "outputDirectory": "public",
  "ignoreCommand": "[ \"$VERCEL_GIT_COMMIT_REF\" != \"main\" ]",
  "git": {
    "deploymentEnabled": {
      "main": true,
      "plugin-dist": false
    }
  },
  "rewrites": [
    { "source": "/activate", "destination": "/api/activate" },
    { "source": "/release", "destination": "/api/release" },
    { "source": "/health", "destination": "/api/health" },
    { "source": "/", "destination": "/api/health" }
  ]
}
